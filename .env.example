NODE_ENV=development
PORT=5000

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB_NAME=legalease

# ── Test database (required for integration test suite with TEST_MONGODB_URI) ─
TEST_MONGODB_URI=
TEST_MONGODB_DB_NAME=legalease_test

# ── CORS / Client origins ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CLIENT_ORIGINS=http://localhost:5173

# ── Authentication ───────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
COOKIE_NAME=legalease_session

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
# Must be at least 32 characters. Generate with: openssl rand -hex 32
GOOGLE_ONBOARDING_SECRET=
GOOGLE_ONBOARDING_COOKIE_NAME=legalease_google_onboarding

# ── Stripe (card payments) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Fee in USD cents — e.g. 5000 = $50.00
LAWYER_PUBLISHING_FEE_CENTS=

# ── SSLCommerz (bKash / Nagad / Rocket — Bangladesh) ───────────────────────
SSCOMMERZ_STORE_ID=
SSCOMMERZ_STORE_PASSWORD=
# Set to true to use sandbox gateway; false or omit for production
SSCOMMERZ_SANDBOX=true

# ── Image hosting (imgBB) ────────────────────────────────────────────────────
IMGBB_API_KEY=

# ── Seed admin account (only used by scripts/seedAdmin.js) ──────────────────
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Transactional email (SMTP) ───────────────────────────────────────────────
# Use Mailtrap for dev; SendGrid/Postmark/SES for production.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ── SMS / OTP — Vonage (optional) ───────────────────────────────────────────
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NUMBER=

# ── Error monitoring — Sentry (optional) ────────────────────────────────────
# Obtain DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
